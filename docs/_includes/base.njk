{#- Started from the Larvatus website's src/_includes/base.njk (../ChatGPT/maskedemail-website). The head, the header band
    with its nav, the title band and the footer are shared with it in shape and must be kept in step by hand: there is
    no shared package. Triplebit's own parts are the section nav (from _data/nav.json, which feeds the header links,
    their dropdown panels, the phone menu and the footer columns) and the home page's JSON-LD.

    Paths are relative ("" at the root, "../" a folder down), as in Larvatus, except on 404.html, which the server
    returns at any depth, so its paths start at the root. -#}
{%- set root = "/" if page.url == "/404.html" else page.url | root -%}
{%- set section = nav | section(page.url) -%}
{%- macro href(url) -%}{{ "./" if url == page.url else (root + url.slice(1)) or "./" }}{%- endmacro -%}
{#- A link to a page in the nav. A page on another site keeps its address, never counts as the current page, and has
    a small arrow after its label. #}
{%- macro item(p) -%}
{%- if p.external -%}
<a href="{{ p.url }}">{{ p.label }}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 8.5l5-5M4.5 3.5h4v4"/></svg></a>
{%- else -%}
<a href="{{ href(p.url) }}"{% if p.url == page.url %} aria-current="page"{% endif %}>{{ p.label }}</a>
{%- endif -%}
{%- endmacro -%}
{#- A section's pages as lists, one per group; a group's label is plain text that names its list. place keeps the
    ids apart (the header panel, the phone menu and the footer each draw the same groups). #}
{%- macro lists(s, place) -%}
{%- for g in s | navGroups %}
{%- if g.label %}
<div class="group" id="{{ place }}-{{ g.id }}">{{ g.label }}</div>
{%- endif %}
<ul{% if g.label %} aria-labelledby="{{ place }}-{{ g.id }}"{% endif %}>
{%- for p in g.pages %}
  <li>{{ item(p) }}</li>
{%- endfor %}
</ul>
{%- endfor %}
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ (pageTitle or title + " · Triplebit") | safe }}</title>
<meta name="description" content="{{ description | safe }}">
{#- The band color in each theme, --band in site.css. A meta tag cannot read a CSS custom property, so change these
    with the palette. #}
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)">
<link rel="icon" href="{{ root }}public/triplebit-logo-square.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ root }}assets/site.css">
{% if page.url == "/" %}{% include "jsonld.html" %}{% endif -%}
</head>
<body>

<header class="band">
  <nav class="wrap nav" aria-label="Main">
    {#- Triplebit's mark without its backing square and with a white middle bar, as on the dark band. Its viewBox is cut
        to the bars' width (see .nav .lockup in site.css). The svg sits in a span so that, as in the footer, it lines up
        with the text by vertical-align. #}
    <a class="lockup" href="{{ href('/') }}"><span><svg viewBox="10 0 44 64" aria-hidden="true"><g transform="translate(10 10) scale(.0859375)"><g transform="matrix(0.496018,0,-0.0914032,0.403727,-118.796,-82.1196)"><rect x="393.826" y="203.404" width="641.427" height="634.09" fill="#0ff"/></g><g transform="matrix(0.496018,0,-0.0911934,0.403727,17.0446,173.88)"><rect x="393.826" y="203.404" width="641.427" height="634.09" fill="#f00"/></g><g transform="matrix(0.496018,0,-0.0914032,0.403727,-50.8209,45.8802)"><rect x="393.826" y="203.404" width="641.427" height="634.09" class="tb-band"/></g></g></svg></span><span>Triplebit</span></a>
    {#- Each section links to its own page and is marked while it or one of its pages is open. On wide screens its
        pages (and groups of pages) show in a panel that opens on hover and on keyboard focus; on phones these links
        hide and the menu button below lists everything. All of it comes from _data/nav.json (its shape is described in
        eleventy.config.js). #}
    {%- for s in nav %}
    {%- set current = (' aria-current="' + ('page' if s.url == page.url else 'true') + '"') if s == section else '' %}
    {%- if s | navPages | length %}
    <div class="hide drop{% if loop.last %} end{% endif %}">
      <a href="{{ href(s.url) }}"{{ current | safe }}>{{ s.label }}</a>
      <div class="panel"><div class="box">{{ lists(s, "drop") }}</div></div>
    </div>
    {%- else %}
    <a class="hide" href="{{ href(s.url) }}"{{ current | safe }}>{{ s.label }}</a>
    {%- endif %}
    {%- endfor %}
    <details class="menu">
      <summary aria-label="Menu"><svg class="open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><svg class="close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></summary>
      <div class="menu-panel">
        {%- for s in nav %}
        {#- Each section's heading links to its own page, and its pages are listed under it. --rows sizes the section
            for packing on phones (the packRows filter). #}
        <div style="--rows: {{ s | packRows('menu') }}">
          <p><a href="{{ href(s.url) }}"{% if s.url == page.url %} aria-current="page"{% endif %}>{{ s.label }}</a></p>
          {{ lists(s, "menu") }}
        </div>
        {%- endfor %}
      </div>
    </details>
    <a class="button light" href="{{ href('/donate/') }}">Donate</a>
  </nav>
{% block band %}
  <div class="wrap title">
    {#- The heading's id is the one MkDocs gave it, so old #links still land; pages whose MkDocs heading had none set
        titleAnchor: false. #}
    {#- titleId sets the id outright, for a page whose title has changed since (Services was "What We Do"). #}
    <h1{% if titleAnchor != false %} id="{{ titleId or (title | headingId) }}"{% endif %}>{{ title }}</h1>
    {%- if subtitle %}
    <p class="date">{{ subtitle }}</p>
    {%- endif %}
  </div>
{% endblock %}
</header>

{% block main %}
<main class="wrap prose">
{{ content | safe }}</main>
{% endblock %}

<footer>
  <div class="wrap">
    {#- The footer is black and in columns, by the owner's choice (2026-11-24), where Larvatus's is one row: the lockup
        with the small print and the Candid seal under it, then a column for each nav section. On desktop widths the
        lockup sits where it does on Larvatus; on a phone the brand column moves below the sections (site.css). #}
    <div class="brand">
      <div class="lockup"><a href="{{ href('/') }}" aria-label="Triplebit"><svg viewBox="0 0 64 64" aria-hidden="true"><rect class="tb-back" width="64" height="64" rx="15"/><g transform="translate(10 10) scale(.0859375)"><g transform="matrix(0.496018,0,-0.0914032,0.403727,-118.796,-82.1196)"><rect x="393.826" y="203.404" width="641.427" height="634.09" fill="#0ff"/></g><g transform="matrix(0.496018,0,-0.0911934,0.403727,17.0446,173.88)"><rect x="393.826" y="203.404" width="641.427" height="634.09" fill="#f00"/></g><g transform="matrix(0.496018,0,-0.0914032,0.403727,-50.8209,45.8802)"><rect x="393.826" y="203.404" width="641.427" height="634.09" class="tb-front"/></g></g></svg></a><span>Triplebit</span></div>
      <p>A Delaware <span class="nobreak">501(c)(3)</span> public charity <span class="nobreak">(EIN 42-3053859)</span></p>
      <a class="seal" href="https://app.candid.org/profile/16663599/triplebit-corporation/?pkId=aee92b4a-e0bc-427c-b5aa-e3750023eb8f&amp;isActive=true"><img src="{{ root }}images/candid-seal-platinum-2026.svg" alt="2026 Candid Seal of Transparency" width="96" height="96"></a>
    </div>
    <nav aria-label="Footer">
      {%- for s in nav %}
      {#- As in the menu, the heading links to the section's own page; --rows sizes it for packing on phones. #}
      <div style="--rows: {{ s | packRows('footer') }}">
        <h2><a href="{{ href(s.url) }}"{% if s.url == page.url %} aria-current="page"{% endif %}>{{ s.label }}</a></h2>
        {{ lists(s, "foot") }}
      </div>
      {%- endfor %}
    </nav>
  </div>
</footer>
</body>
</html>
